JWT_SECRET=<your_secret_key>
SUPABASE_URL=<your_supabase_url>
SUPABASE_ANON_KEY=<your_supabase_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<your_supabase_service_role_key>
ANTHROPIC_API_KEY=<your_anthropic_api_key>

# Comma-separated list of allowed frontend origins (CORS).
# Leave unset locally to allow all origins; set to your deployed frontend URL in production.
FRONTEND_URL=https://your-frontend.vercel.app

# Local dev only: bypass Supabase token verification. NEVER set this in production.
DEV_BYPASS=true

# Port the server listens on. Hosts like Render/Railway inject this automatically.
PORT=3000
